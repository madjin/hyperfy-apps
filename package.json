{
  "name": "hyperfy-apps",
  "version": "1.0.0",
  "description": "Hyperfy V1 and V2 app archive with extraction tools",
  "type": "module",
  "scripts": {
    "extract": "node extract-hyp.mjs v2-hyp --project v2",
    "extract:single": "node extract-hyp.mjs",
    "catalog:build": "python scripts/catalog/build_catalog.py",
    "catalog:dry-run": "python scripts/catalog/build_catalog.py --dry-run",
    "catalog:context": "python scripts/research/prepare_context_bundle.py",
    "catalog:summarize": "python scripts/research/summarize_hyp_files_openrouter.py",
    "catalog:summarize:dry-run": "python scripts/research/summarize_hyp_files_openrouter.py --dry-run",
    "explorer:build": "python scripts/catalog/build_explorer_data.py",
    "explorer:serve": "python -m http.server 8080",
    "build:all": "python scripts/catalog/build_catalog.py --skip-optimize && python scripts/catalog/build_explorer_data.py"
  },
  "keywords": [
    "hyperfy",
    "virtual-worlds",
    "metaverse",
    "apps"
  ],
  "dependencies": {
    "fs-extra": "^11.2.0"
  }
}
